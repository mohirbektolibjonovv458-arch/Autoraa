# --- Asosiy ---
SECRET_KEY=            # bo'sh qolsa ishga tushganda avtomatik yaratiladi
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (DATABASE_URL yoki POSTGRES_*; ikkalasi ham bo'sh bo'lsa SQLite — faqat lokal sinov uchun) ---
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- AI (Anthropic Claude API) ---
# https://console.anthropic.com -> API Keys. Kalit faqat shu yerda (backend) saqlanadi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Tariflar bo'yicha kunlik AI xabarlar limiti ---
AI_DAILY_LIMIT_FREE=15
AI_DAILY_LIMIT_PREMIUM=200

# --- Premium to'lov (qo'lda tasdiqlanadi; onlayn to'lov tizimi ulanmagan) ---
PREMIUM_PRICE_UZS=49000
PREMIUM_PAYMENT_INSTRUCTIONS=
