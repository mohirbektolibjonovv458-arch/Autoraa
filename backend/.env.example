# ===== Avtora sozlamalari =====
# Bu fayl MAXFIY — hech kimga yubormang va GitHub'ga yuklamang.

SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DEBUG=0
PORT=8000

# --- Serverga joylashda (domen) ---
# Domeningiz (masalan avtora.uz). To'ldirilsa ALLOWED_HOSTS, CSRF va SITE_URL avtomatik sozlanadi.
# Kompyuterda sinash uchun bo'sh qoldiring.
DOMAIN=
ALLOWED_HOSTS=*

# --- Telegram botlar (ulangan) ---
# 1) Kirish / ro'yxatdan o'tish kodlari boti
AUTH_BOT_TOKEN=
# 2) Premium to'lov boti
PREMIUM_BOT_TOKEN=

# --- Premium ---
PREMIUM_CARD_NUMBER=4073420079545178
PREMIUM_CARD_HOLDER=Avtora
PREMIUM_PRICE=40000

# --- Ixtiyoriy ---
# Saytni HTTPS domen bilan ishlatganda, masalan: https://avtora.uz
CSRF_TRUSTED_ORIGINS=
SITE_URL=
# PostgreSQL (bo'sh bo'lsa SQLite — kichik/o'rta loyiha uchun yetarli). Ishlatsangiz: pip install psycopg2-binary
POSTGRES_DB=
POSTGRES_USER=postgres
# Docker (docker-compose) ishlatilganda baza paroli shu yerdan olinadi
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Admin (birinchi ishga tushishda avtomatik yaratiladi; bo'sh bo'lsa so'raladi). Parol kamida 8 belgi.
ADMIN_PHONE=
ADMIN_PASSWORD=
# Django'ning ichki admin paneli (/django-admin/) — kerak bo'lsagina 1 qiling
DJANGO_ADMIN=0
# Admin panel himoyasi: parol + Telegram kod (2FA). Admin raqami kod botiga ulangan bo'lishi shart.
ADMIN_2FA=1
# Admin faqat shu IP lardan kira olsin (vergul bilan, masalan ofis IP si). Bo'sh — cheklovsiz
ADMIN_ALLOWED_IPS=

# --- Xarita plitalari (kalit faqat serverda, frontendga berilmaydi) ---
# Bo'sh — OpenStreetMap standart plitalari (kichik/o'rta trafik). Katta trafik uchun tijoriy provayder, masalan:
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key={key}
MAP_TILE_URL=
MAP_TILE_KEY=
MAP_ATTRIBUTION=

# --- Push bildirishnomalar (Web Push / VAPID) ---
# Bo'sh qoldiring — birinchi ishga tushishda avtomatik yaratiladi. Productionda BIR MARTA yaratilgan kalitni o'zgartirmang.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@avtora.uz
# yoki faqat email: VAPID_EMAIL=admin@avtora.uz

# --- Play Market (Trusted Web Activity) — ixtiyoriy ---
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINTS=

# --- Marshrut (ilova ichida). Bo'sh — OSRM ochiq serveri (kichik trafik). Ko'p foydalanuvchida o'z OSRM serveringiz ---
ROUTING_URL=
ROUTING_KEY=

# --- Sun'iy yo'ldosh xaritasi (uylar, ko'chalar). Bo'sh — Esri World Imagery. Tijoriy foydalanishda provayder kalitini oling ---
SAT_ENABLED=1
SAT_TILE_URL=
SAT_LABELS_URL=
SAT_TILE_KEY=
SAT_ATTRIBUTION=

# --- Google bilan kirish (ixtiyoriy) ---
# Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID → Web application.
# «Authorized JavaScript origins»: https://SIZNING-DOMEN (va lokal sinov uchun http://localhost:8000).
# Client SECRET kerak emas. Bo'sh qoldirilsa «Google bilan davom etish» tugmasi ko'rinmaydi.
GOOGLE_CLIENT_ID=
